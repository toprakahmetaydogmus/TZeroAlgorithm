{
  "name": "tzero-context-architect",
  "displayName": "T-Zero Context Architect & MCP",
  "description": "Enterprise AST Codebase Context Engine & 37-Tool Autonomous MCP Server. Cuts LLM tokens by up to 95% with 0 API leaks.",
  "version": "10.0.0",
  "publisher": "toprakahmetaydogmus",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "token-reduction",
    "context-window",
    "ast",
    "claude",
    "ai-agents"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tzero.openDashboard",
        "title": "T-Zero: Open Control Center Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "tzero.scanWorkspace",
        "title": "T-Zero: Scan Codebase AST & Token Savings",
        "icon": "$(search)"
      },
      {
        "command": "tzero.auditSecurity",
        "title": "T-Zero: Run 100% Zero-Leak Security Audit",
        "icon": "$(shield)"
      },
      {
        "command": "tzero.exportRules",
        "title": "T-Zero: Generate AI Agent Rules (.cursorrules)",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "tzero.openDashboard" },
        { "command": "tzero.scanWorkspace" },
        { "command": "tzero.auditSecurity" },
        { "command": "tzero.exportRules" }
      ]
    },
    "configuration": {
      "title": "T-Zero Context Architect",
      "properties": {
        "tzero.dashboardPort": {
          "type": "number",
          "default": 8421,
          "description": "Port for the local T-Zero Control Center dashboard"
        },
        "tzero.autoScanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically calculate token reduction on file save"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toprakahmetaydogmus/TZeroAlgorithm"
  }
}
