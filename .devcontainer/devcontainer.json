{
  "name": "T-Zero Context Architect & MCP Studio",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "siber-akademi.tzero-vscode"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e . && tzero --info",
  "forwardPorts": [8425, 8000],
  "portsAttributes": {
    "8425": {
      "label": "T-Zero Cockpit TUI",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Benchmark Hub",
      "onAutoForward": "notify"
    }
  }
}
